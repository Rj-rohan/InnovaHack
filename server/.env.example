# ---------------------------------------------------------------------------
# server/.env  — the agent service. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- LLM providers. Both free; at least one is required, both is better ------
# Gemini (https://aistudio.google.com/apikey) — drives the normal agent. Most reliable
# free-tier function calling, which is what scenario A depends on.
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys) — drives the compromised agent and doubles as
# failover. Open-weight models are less injection-hardened, which is what makes the
# attack scenario land; and a 429 on Gemini is not a 429 on Groq.
GROQ_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# --- Chain ------------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# The agent's SESSION key. Generate with:
#   cd contracts && npx hardhat run scripts/new-session-key.ts
#
# This key can only propose payments. It cannot pause, unpause, change limits, edit the
# allowlist, or withdraw. NEVER put the owner key here — the service refuses to start if
# this address equals the wallet owner, because an agent that can unfreeze itself makes
# the entire project meaningless.
#
# Fund its ADDRESS with a little Sepolia ETH; the agent pays its own gas.
AGENT_SESSION_KEY_PRIVATE=0x

# --- Ingest (writes to MongoDB via the Next.js app) -------------------------
# This service holds no database driver. All persistence goes through client/'s API.
INGEST_URL=http://localhost:3000
INGEST_SECRET=change-me-to-a-long-random-string

# --- Loop tuning ------------------------------------------------------------
# Sepolia blocks are ~12s. Ticking faster races the chain and burns free-tier rate limit.
AGENT_TICK_SECONDS=25
MAX_TOOL_ITERATIONS=6
