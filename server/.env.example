# ---------------------------------------------------------------------------
# server/.env  — the agent service. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- LLM providers. Both free; at least one is required, both is better ------
# Gemini (https://aistudio.google.com/apikey) — drives the normal agent. Most reliable
# free-tier function calling, which is what the everyday path depends on.
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys) — drives the compromised agent and doubles as
# failover. Open-weight models are less injection-hardened, which is what makes the
# attack scenario land; and a 429 on Gemini is not a 429 on Groq.
GROQ_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# --- Chain ------------------------------------------------------------------
# Defaults target a local Hardhat node: no faucet, no key ceremony, instant blocks.
#
# To promote to a public testnet, set these two and provide a real session key below.
# Nothing else changes — chain-specific settings live in the CHAIN_PROFILES table in
# config.py, mirroring client/lib/chains.ts.
#
#   Sepolia:  CHAIN_ID=11155111
#             RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8550

# The agent's SESSION key — it can only propose payments. It cannot pause, unpause,
# change limits, edit the allowlist, or withdraw. The service refuses to start if this
# address equals the wallet owner, because an agent that can unfreeze itself makes the
# whole project meaningless.
#
# On chain 31337 this defaults to Hardhat account #1 (0x7099...79C8), whose key is in
# every tutorial on the internet. That is fine on a throwaway local node and is why the
# default is gated to 31337 — on any other chain the key is REQUIRED, so a public
# deployment can never be signed by a well-known account.
#
#   Generate a real one:  cd contracts && npx hardhat run scripts/new-session-key.ts
# AGENT_SESSION_KEY_PRIVATE=0x

# --- Ingest (writes to MongoDB via the Next.js app) -------------------------
# This service holds no database driver. All persistence goes through client/'s API.
INGEST_URL=http://localhost:3000
INGEST_SECRET=change-me-to-a-long-random-string

# --- Loop tuning ------------------------------------------------------------
# Omit to use the per-chain default (8s local, 25s on Sepolia's ~12s blocks).
# AGENT_TICK_SECONDS=8
MAX_TOOL_ITERATIONS=8
