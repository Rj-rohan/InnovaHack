# ---------------------------------------------------------------------------
# contracts/.env  — deployment only. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# Sepolia RPC. Any free provider works (Alchemy, Infura, drpc, PublicNode).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The OWNER key. Deploys the contracts and holds the kill switch.
# This key must NEVER appear in server/.env — if the agent process could reach it,
# the agent could unfreeze itself and the whole guarantee collapses.
OWNER_PRIVATE_KEY=0x

# The agent's session key ADDRESS (not the private key).
# Generate with:  npx hardhat run scripts/new-session-key.ts
AGENT_SESSION_KEY_ADDRESS=0x

# Demo counterparties. Any addresses will do — they only receive mUSDC.
# Generate throwaway ones with scripts/new-session-key.ts if you need them.
DEMO_VENDOR_1=0x
DEMO_VENDOR_2=0x
DEMO_GAS_REFILL=0x

# Optional: for `npx hardhat verify --network sepolia ...`
ETHERSCAN_API_KEY=
